* -----------------------------------------------------------------
* ETAPE 1 : CALIBRATION ET IMPORTATION
* -----------------------------------------------------------------

* 1. Définir la fréquence (trimestrielle) et la date de début
CALENDAR(Q) 2013:1

* 2. Allouer de l'espace mémoire jusqu'en 2025:1 (pour la prévision T+1)
ALLOCATE 2025:1

* 3. Ouvrir le fichier
OPEN DATA "D:\Home\legachet\OneDrive - Université de Rennes\école\techniques de prévisions économiques\projet\data\hierarchical prison 2024 data base.xlsx"

* 4. Lire les données
* On spécifie la plage de lecture : de 2013:1 à 2024:4
DATA(FORMAT=XLSX, ORG=COLUMNS) 2013:1 2024:4

* -----------------------------------------------------------------
* ETAPE 2 : CONSTRUCTION DE LA HIERARCHIE (AGREGATION)
* -----------------------------------------------------------------
* Nous construisons les niveaux supérieurs en additionnant les séries du bas.
* Structure : Etat (8) x Genre (2) x Statut (2) = 32 séries de base.

* --- NIVEAU 1 : TOTAUX PAR ETAT (8 Séries) ---
Set ACT = ACTFRemanded + ACTFSentenced + ACTMRemanded + ACTMSentenced
Set NSW = NSWFRemanded + NSWFSentenced + NSWMRemanded + NSWMSentenced
Set NT  = NTFRemanded  + NTFSentenced  + NTMRemanded  + NTMSentenced
Set QLD = QLDFRemanded + QLDFSentenced + QLDMRemanded + QLDMSentenced
Set SA  = SAFRemanded  + SAFSentenced  + SAMRemanded  + SAMSentenced
Set TAS = TASFRemanded + TASFSentenced + TASMRemanded + TASMSentenced
Set VIC = VICFRemanded + VICFSentenced + VICMRemanded + VICMSentenced
Set WA  = WAFRemanded  + WAFSentenced  + WAMRemanded  + WAMSentenced

* --- NIVEAU 0 : TOTAL AUSTRALIE ---
Set TOTAL_AUS = ACT + NSW + NT + QLD + SA + TAS + VIC + WA

* --- NIVEAUX GROUPES ---
* Total par genre
Set TOTAL_F = ACTFRemanded + ACTFSentenced + NSWFRemanded + NSWFSentenced + NTFRemanded + NTFSentenced + QLDFRemanded + QLDFSentenced + SAFRemanded + SAFSentenced + TASFRemanded + TASFSentenced + VICFRemanded + VICFSentenced + WAFRemanded + WAFSentenced
Set TOTAL_M = TOTAL_AUS - TOTAL_F

* Total par statut légal
Set TOTAL_REMANDED = ACTFRemanded + ACTMRemanded + NSWFRemanded + NSWMRemanded + NTFRemanded + NTMRemanded + QLDFRemanded + QLDMRemanded + SAFRemanded + SAMRemanded + TASFRemanded + TASMRemanded + VICFRemanded + VICMRemanded + WAFRemanded + WAMRemanded
Set TOTAL_SENTENCED = TOTAL_AUS - TOTAL_REMANDED



* -----------------------------------------------------------------
* VERIFICATION VISUELLE
* -----------------------------------------------------------------
GRAPH(HEADER="Total prisonniers Australie (2013-2024)") 1
# TOTAL_AUS




* -----------------------------------------------------------------
* ETAPE 3 : GRAPHIQUES POUR ANALYSE DESCRIPTIVE
* -----------------------------------------------------------------

* 1. Comparaison par statut juridique et genre (mosaïque)
SPGRAPH(HFIELDS=2, VFIELDS=2, HEADER="Analyse par composantes (2013-2024)", FOOTER="Source: Données prisons Australie")
 GRAPHI(HEADER="Prisonniers en attente (Remanded)") 1
 # TOTAL_REMANDED
 GRAPHI(HEADER="Prisonniers condamnés (Sentenced)") 1
 # TOTAL_SENTENCED
 GRAPHI(HEADER="Population féminine") 1
 # TOTAL_F
 GRAPHI(HEADER="Population masculine") 1
 # TOTAL_M
SPGRAPH(DONE)

* 2. Comparaison des dynamiques régionales (les 3 plus gros États)
GRAPH(KEY=UPLEFT, HEADER="Comparaison NSW - QLD - VIC") 3
# NSW
# QLD
# VIC




* -----------------------------------------------------------------
* ETAPE 4 : PREVISIONS BOTTOM-UP AVEC INCERTITUDE
* -----------------------------------------------------------------

* 1. Liste des séries
DEC VECT[SERIES] BOTTOM_LIST(32)
COMPUTE BOTTOM_LIST = || $
ACTFRemanded, ACTFSentenced, ACTMRemanded, ACTMSentenced, $
NSWFRemanded, NSWFSentenced, NSWMRemanded, NSWMSentenced, $
NTFRemanded, NTFSentenced, NTMRemanded, NTMSentenced, $
QLDFRemanded, QLDFSentenced, QLDMRemanded, QLDMSentenced, $
SAFRemanded, SAFSentenced, SAMRemanded, SAMSentenced, $
TASFRemanded, TASFSentenced, TASMRemanded, TASMSentenced, $
VICFRemanded, VICFSentenced, VICMRemanded, VICMSentenced, $
WAFRemanded, WAFSentenced, WAMRemanded, WAMSentenced ||

* 2. Stockage
DEC VECT[SERIES] STORED_FORECASTS(32)
DEC VECT[SERIES] STORED_VARIANCES(32)
DECLARE SERIES TEMP_RESIDS

* 3. Boucle de calcul
DOFOR i = 1 TO 32
   * A. On récupère les résidus
   ESMOOTH(TREND=SELECT, SEASONAL=NONE, FORECAST=STORED_FORECASTS(i), RESIDS=TEMP_RESIDS, STEPS=1, NOPRINT) BOTTOM_LIST(i)

   * B. On calcule la variance des résidus
   STATISTICS(NOPRINT) TEMP_RESIDS

   * C. On stocke cette variance pour 2025:1
   SET STORED_VARIANCES(i) 2025:1 2025:1 = %VARIANCE
END DOFOR


* -----------------------------------------------------------------
* ETAPE 5 : AGREGATION (PREVISIONS, HISTORIQUE & VARIANCES)
* -----------------------------------------------------------------

* --- A. TOTAL AUSTRALIE ---
SET FCST_TOTAL = 0.0
SET VAR_TOTAL  = 0.0
SET HIST_TOTAL = 0.0

DOFOR i = 1 TO 32
   SET FCST_TOTAL = FCST_TOTAL + STORED_FORECASTS(i)
   SET VAR_TOTAL  = VAR_TOTAL  + STORED_VARIANCES(i)
   SET HIST_TOTAL = HIST_TOTAL + BOTTOM_LIST(i)
END DOFOR
SET SE_TOTAL = SQRT(VAR_TOTAL)

* --- B. PAR ETAT ---
DECLARE SERIES FCST_ACT VAR_ACT HIST_ACT SE_ACT
DECLARE SERIES FCST_NSW VAR_NSW HIST_NSW SE_NSW
DECLARE SERIES FCST_NT  VAR_NT  HIST_NT  SE_NT
DECLARE SERIES FCST_QLD VAR_QLD HIST_QLD SE_QLD
DECLARE SERIES FCST_SA  VAR_SA  HIST_SA  SE_SA
DECLARE SERIES FCST_TAS VAR_TAS HIST_TAS SE_TAS
DECLARE SERIES FCST_VIC VAR_VIC HIST_VIC SE_VIC
DECLARE SERIES FCST_WA  VAR_WA  HIST_WA  SE_WA

* ACT
SET FCST_ACT = STORED_FORECASTS(1)+STORED_FORECASTS(2)+STORED_FORECASTS(3)+STORED_FORECASTS(4)
SET VAR_ACT  = STORED_VARIANCES(1)+STORED_VARIANCES(2)+STORED_VARIANCES(3)+STORED_VARIANCES(4)
SET HIST_ACT = BOTTOM_LIST(1)+BOTTOM_LIST(2)+BOTTOM_LIST(3)+BOTTOM_LIST(4)
SET SE_ACT   = SQRT(VAR_ACT)
* NSW
SET FCST_NSW = STORED_FORECASTS(5)+STORED_FORECASTS(6)+STORED_FORECASTS(7)+STORED_FORECASTS(8)
SET VAR_NSW  = STORED_VARIANCES(5)+STORED_VARIANCES(6)+STORED_VARIANCES(7)+STORED_VARIANCES(8)
SET HIST_NSW = BOTTOM_LIST(5)+BOTTOM_LIST(6)+BOTTOM_LIST(7)+BOTTOM_LIST(8)
SET SE_NSW   = SQRT(VAR_NSW)
* NT
SET FCST_NT = STORED_FORECASTS(9)+STORED_FORECASTS(10)+STORED_FORECASTS(11)+STORED_FORECASTS(12)
SET VAR_NT  = STORED_VARIANCES(9)+STORED_VARIANCES(10)+STORED_VARIANCES(11)+STORED_VARIANCES(12)
SET HIST_NT = BOTTOM_LIST(9)+BOTTOM_LIST(10)+BOTTOM_LIST(11)+BOTTOM_LIST(12)
SET SE_NT   = SQRT(VAR_NT)
* QLD
SET FCST_QLD = STORED_FORECASTS(13)+STORED_FORECASTS(14)+STORED_FORECASTS(15)+STORED_FORECASTS(16)
SET VAR_QLD  = STORED_VARIANCES(13)+STORED_VARIANCES(14)+STORED_VARIANCES(15)+STORED_VARIANCES(16)
SET HIST_QLD = BOTTOM_LIST(13)+BOTTOM_LIST(14)+BOTTOM_LIST(15)+BOTTOM_LIST(16)
SET SE_QLD   = SQRT(VAR_QLD)
* SA
SET FCST_SA = STORED_FORECASTS(17)+STORED_FORECASTS(18)+STORED_FORECASTS(19)+STORED_FORECASTS(20)
SET VAR_SA  = STORED_VARIANCES(17)+STORED_VARIANCES(18)+STORED_VARIANCES(19)+STORED_VARIANCES(20)
SET HIST_SA = BOTTOM_LIST(17)+BOTTOM_LIST(18)+BOTTOM_LIST(19)+BOTTOM_LIST(20)
SET SE_SA   = SQRT(VAR_SA)
* TAS
SET FCST_TAS = STORED_FORECASTS(21)+STORED_FORECASTS(22)+STORED_FORECASTS(23)+STORED_FORECASTS(24)
SET VAR_TAS  = STORED_VARIANCES(21)+STORED_VARIANCES(22)+STORED_VARIANCES(23)+STORED_VARIANCES(24)
SET HIST_TAS = BOTTOM_LIST(21)+BOTTOM_LIST(22)+BOTTOM_LIST(23)+BOTTOM_LIST(24)
SET SE_TAS   = SQRT(VAR_TAS)
* VIC
SET FCST_VIC = STORED_FORECASTS(25)+STORED_FORECASTS(26)+STORED_FORECASTS(27)+STORED_FORECASTS(28)
SET VAR_VIC  = STORED_VARIANCES(25)+STORED_VARIANCES(26)+STORED_VARIANCES(27)+STORED_VARIANCES(28)
SET HIST_VIC = BOTTOM_LIST(25)+BOTTOM_LIST(26)+BOTTOM_LIST(27)+BOTTOM_LIST(28)
SET SE_VIC   = SQRT(VAR_VIC)
* WA
SET FCST_WA = STORED_FORECASTS(29)+STORED_FORECASTS(30)+STORED_FORECASTS(31)+STORED_FORECASTS(32)
SET VAR_WA  = STORED_VARIANCES(29)+STORED_VARIANCES(30)+STORED_VARIANCES(31)+STORED_VARIANCES(32)
SET HIST_WA = BOTTOM_LIST(29)+BOTTOM_LIST(30)+BOTTOM_LIST(31)+BOTTOM_LIST(32)
SET SE_WA   = SQRT(VAR_WA)

* --- C. PAR STATUT ---
SET FCST_REMANDED = 0.0
SET VAR_REMANDED  = 0.0
SET HIST_REMANDED = 0.0
SET FCST_SENTENCED = 0.0
SET VAR_SENTENCED  = 0.0
SET HIST_SENTENCED = 0.0

DOFOR i = 1 TO 32
   IF %MOD(i,2)==1 {
      SET FCST_REMANDED = FCST_REMANDED + STORED_FORECASTS(i)
      SET VAR_REMANDED  = VAR_REMANDED  + STORED_VARIANCES(i)
      SET HIST_REMANDED = HIST_REMANDED + BOTTOM_LIST(i)
   }
   ELSE {
      SET FCST_SENTENCED = FCST_SENTENCED + STORED_FORECASTS(i)
      SET VAR_SENTENCED  = VAR_SENTENCED  + STORED_VARIANCES(i)
      SET HIST_SENTENCED = HIST_SENTENCED + BOTTOM_LIST(i)
   }
END DOFOR
SET SE_REMANDED = SQRT(VAR_REMANDED)
SET SE_SENTENCED = SQRT(VAR_SENTENCED)

* --- D. PAR GENRE ---
SET FCST_FEMME = 0.0
SET VAR_FEMME  = 0.0
SET HIST_FEMME = 0.0
SET FCST_HOMME = 0.0
SET VAR_HOMME  = 0.0
SET HIST_HOMME = 0.0

DOFOR i = 0 TO 7
   * Femmes
   SET FCST_FEMME = FCST_FEMME + STORED_FORECASTS(i*4+1) + STORED_FORECASTS(i*4+2)
   SET VAR_FEMME  = VAR_FEMME  + STORED_VARIANCES(i*4+1) + STORED_VARIANCES(i*4+2)
   SET HIST_FEMME = HIST_FEMME + BOTTOM_LIST(i*4+1) + BOTTOM_LIST(i*4+2)

   * Hommes
   SET FCST_HOMME = FCST_HOMME + STORED_FORECASTS(i*4+3) + STORED_FORECASTS(i*4+4)
   SET VAR_HOMME  = VAR_HOMME  + STORED_VARIANCES(i*4+3) + STORED_VARIANCES(i*4+4)
   SET HIST_HOMME = HIST_HOMME + BOTTOM_LIST(i*4+3) + BOTTOM_LIST(i*4+4)
END DOFOR
SET SE_FEMME = SQRT(VAR_FEMME)
SET SE_HOMME = SQRT(VAR_HOMME)


* -----------------------------------------------------------------
* RESULTATS : TABLEAU DE BORD
* -----------------------------------------------------------------

* Définition des colonnes
REPORT(ACTION=DEFINE, HLABELS=||"SERIE", "REEL 24:4", "PREV 25:1", "BORNE INF(95%)", "BORNE SUP(95%)", "VAR PREV.", "VAR MIN", "VAR MAX"||)

* --- TOTAL ---
COMPUTE VAL_HIST = HIST_TOTAL(2024:4)
COMPUTE VAL_FCST = FCST_TOTAL(2025:1)
COMPUTE VAL_LOW  = VAL_FCST - 1.96 * SE_TOTAL(2025:1)
COMPUTE VAL_HIGH = VAL_FCST + 1.96 * SE_TOTAL(2025:1)
* Calcul des 3 variations
COMPUTE V_PREV = VAL_FCST - VAL_HIST
COMPUTE V_MIN  = VAL_LOW  - VAL_HIST
COMPUTE V_MAX  = VAL_HIGH - VAL_HIST

REPORT(ROW=NEW, ATCOL=1) "TOTAL AUSTRALIE" VAL_HIST VAL_FCST VAL_LOW VAL_HIGH V_PREV V_MIN V_MAX

REPORT(ROW=NEW) " "
REPORT(ROW=NEW) "--- PAR ETAT ---"

* FONCTION POUR SIMPLIFIER L'AFFICHAGE
* ACT
COMPUTE VAL_H=HIST_ACT(2024:4), VAL_F=FCST_ACT(2025:1), SE=SE_ACT(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "ACT" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* NSW
COMPUTE VAL_H=HIST_NSW(2024:4), VAL_F=FCST_NSW(2025:1), SE=SE_NSW(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "NSW" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* NT
COMPUTE VAL_H=HIST_NT(2024:4), VAL_F=FCST_NT(2025:1), SE=SE_NT(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "NT" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* QLD
COMPUTE VAL_H=HIST_QLD(2024:4), VAL_F=FCST_QLD(2025:1), SE=SE_QLD(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "QLD" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* SA
COMPUTE VAL_H=HIST_SA(2024:4), VAL_F=FCST_SA(2025:1), SE=SE_SA(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "SA" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* TAS
COMPUTE VAL_H=HIST_TAS(2024:4), VAL_F=FCST_TAS(2025:1), SE=SE_TAS(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "TAS" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* VIC
COMPUTE VAL_H=HIST_VIC(2024:4), VAL_F=FCST_VIC(2025:1), SE=SE_VIC(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "VIC" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* WA
COMPUTE VAL_H=HIST_WA(2024:4), VAL_F=FCST_WA(2025:1), SE=SE_WA(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "WA" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

REPORT(ROW=NEW) " "
REPORT(ROW=NEW) "--- PAR STATUT ---"

* REMANDED
COMPUTE VAL_H=HIST_REMANDED(2024:4), VAL_F=FCST_REMANDED(2025:1), SE=SE_REMANDED(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "Remanded" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* SENTENCED
COMPUTE VAL_H=HIST_SENTENCED(2024:4), VAL_F=FCST_SENTENCED(2025:1), SE=SE_SENTENCED(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "Sentenced" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

REPORT(ROW=NEW) " "
REPORT(ROW=NEW) "--- PAR GENRE ---"

* FEMMES
COMPUTE VAL_H=HIST_FEMME(2024:4), VAL_F=FCST_FEMME(2025:1), SE=SE_FEMME(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "Femmes" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

* HOMMES
COMPUTE VAL_H=HIST_HOMME(2024:4), VAL_F=FCST_HOMME(2025:1), SE=SE_HOMME(2025:1)
COMPUTE LOW=VAL_F-1.96*SE, HIGH=VAL_F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "Hommes" VAL_H VAL_F LOW HIGH (VAL_F-VAL_H) (LOW-VAL_H) (HIGH-VAL_H)

REPORT(ACTION=SHOW)





* -----------------------------------------------------------------
* ETAPE 6 : TABLEAUX CROISES AVEC INCERTITUDE & VARIATIONS
* -----------------------------------------------------------------

DEC VECT[STRING] STATE_NAMES(8)
COMPUTE STATE_NAMES = ||"ACT","NSW","NT","QLD","SA","TAS","VIC","WA"||

* =================================================================
* PARTIE 1 : ANALYSE PAR GENRE (DETAILS REGIONAUX)
* =================================================================

* --- TABLEAU 1A : FEMMES PAR ETAT ---
REPORT(ACTION=DEFINE, HLABELS=||"ETAT (F)", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

DOFOR i = 1 TO 8
   COMPUTE base_idx = (i-1)*4
   * Indices femmes : 1 et 2
   * 1. Calculs Historique / Prevision / Variance
   COMPUTE V_HIST = BOTTOM_LIST(base_idx+1)(2024:4) + BOTTOM_LIST(base_idx+2)(2024:4)
   COMPUTE V_FCST = STORED_FORECASTS(base_idx+1)(2025:1) + STORED_FORECASTS(base_idx+2)(2025:1)
   COMPUTE V_VAR  = STORED_VARIANCES(base_idx+1)(2025:1) + STORED_VARIANCES(base_idx+2)(2025:1)

   * 2. Ecart-Type et bornes
   COMPUTE SE = SQRT(V_VAR)
   COMPUTE V_LOW = V_FCST - 1.96 * SE
   COMPUTE V_HIGH = V_FCST + 1.96 * SE

   * 3. Variations
   COMPUTE D_PREV = V_FCST - V_HIST
   COMPUTE D_MIN  = V_LOW - V_HIST
   COMPUTE D_MAX  = V_HIGH - V_HIST

   REPORT(ROW=NEW, ATCOL=1) STATE_NAMES(i) V_HIST V_FCST V_LOW V_HIGH D_PREV D_MIN D_MAX
END DOFOR
REPORT(ACTION=SHOW, TITLE="FOCUS FEMMES PAR ETAT")


* --- TABLEAU 1B : HOMMES PAR ETAT ---
REPORT(ACTION=DEFINE, HLABELS=||"ETAT (H)", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

DOFOR i = 1 TO 8
   COMPUTE base_idx = (i-1)*4
   * Indices hommes : 3 et 4
   COMPUTE V_HIST = BOTTOM_LIST(base_idx+3)(2024:4) + BOTTOM_LIST(base_idx+4)(2024:4)
   COMPUTE V_FCST = STORED_FORECASTS(base_idx+3)(2025:1) + STORED_FORECASTS(base_idx+4)(2025:1)
   COMPUTE V_VAR  = STORED_VARIANCES(base_idx+3)(2025:1) + STORED_VARIANCES(base_idx+4)(2025:1)

   COMPUTE SE = SQRT(V_VAR)
   COMPUTE V_LOW = V_FCST - 1.96 * SE
   COMPUTE V_HIGH = V_FCST + 1.96 * SE

   COMPUTE D_PREV = V_FCST - V_HIST
   COMPUTE D_MIN  = V_LOW - V_HIST
   COMPUTE D_MAX  = V_HIGH - V_HIST

   REPORT(ROW=NEW, ATCOL=1) STATE_NAMES(i) V_HIST V_FCST V_LOW V_HIGH D_PREV D_MIN D_MAX
END DOFOR
REPORT(ACTION=SHOW, TITLE="FOCUS HOMMES PAR ETAT")


* =================================================================
* PARTIE 2 : ANALYSE PAR STATUT (DETAILS REGIONAUX)
* =================================================================

* --- TABLEAU 2A : REMANDED (EN ATTENTE) PAR ETAT ---
REPORT(ACTION=DEFINE, HLABELS=||"ETAT (REM)", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

DOFOR i = 1 TO 8
   COMPUTE base_idx = (i-1)*4
   * Indices remanded : 1 et 3
   COMPUTE V_HIST = BOTTOM_LIST(base_idx+1)(2024:4) + BOTTOM_LIST(base_idx+3)(2024:4)
   COMPUTE V_FCST = STORED_FORECASTS(base_idx+1)(2025:1) + STORED_FORECASTS(base_idx+3)(2025:1)
   COMPUTE V_VAR  = STORED_VARIANCES(base_idx+1)(2025:1) + STORED_VARIANCES(base_idx+3)(2025:1)

   COMPUTE SE = SQRT(V_VAR)
   COMPUTE V_LOW = V_FCST - 1.96 * SE
   COMPUTE V_HIGH = V_FCST + 1.96 * SE

   COMPUTE D_PREV = V_FCST - V_HIST
   COMPUTE D_MIN  = V_LOW - V_HIST
   COMPUTE D_MAX  = V_HIGH - V_HIST

   REPORT(ROW=NEW, ATCOL=1) STATE_NAMES(i) V_HIST V_FCST V_LOW V_HIGH D_PREV D_MIN D_MAX
END DOFOR
REPORT(ACTION=SHOW, TITLE="FOCUS REMANDED PAR ETAT")


* --- TABLEAU 2B : SENTENCED (CONDAMNES) PAR ETAT ---
REPORT(ACTION=DEFINE, HLABELS=||"ETAT (SEN)", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

DOFOR i = 1 TO 8
   COMPUTE base_idx = (i-1)*4
   * Indices sentenced : 2 et 4
   COMPUTE V_HIST = BOTTOM_LIST(base_idx+2)(2024:4) + BOTTOM_LIST(base_idx+4)(2024:4)
   COMPUTE V_FCST = STORED_FORECASTS(base_idx+2)(2025:1) + STORED_FORECASTS(base_idx+4)(2025:1)
   COMPUTE V_VAR  = STORED_VARIANCES(base_idx+2)(2025:1) + STORED_VARIANCES(base_idx+4)(2025:1)

   COMPUTE SE = SQRT(V_VAR)
   COMPUTE V_LOW = V_FCST - 1.96 * SE
   COMPUTE V_HIGH = V_FCST + 1.96 * SE

   COMPUTE D_PREV = V_FCST - V_HIST
   COMPUTE D_MIN  = V_LOW - V_HIST
   COMPUTE D_MAX  = V_HIGH - V_HIST

   REPORT(ROW=NEW, ATCOL=1) STATE_NAMES(i) V_HIST V_FCST V_LOW V_HIGH D_PREV D_MIN D_MAX
END DOFOR
REPORT(ACTION=SHOW, TITLE="FOCUS SENTENCED PAR ETAT")


* =================================================================
* PARTIE 3 : CROISEMENT GLOBAL (GENRE x STATUT)
* =================================================================

* Synthétise les 4 grandes masses (F-Rem, F-Sen, M-Rem, M-Sen)
REPORT(ACTION=DEFINE, HLABELS=||"CATEGORIE", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

* -- 1. FEMMES REMANDED --
COMPUTE H=0.0, F=0.0, V=0.0
DOFOR i = 1 TO 8
   COMPUTE idx = (i-1)*4 + 1
   COMPUTE H = H + BOTTOM_LIST(idx)(2024:4)
   COMPUTE F = F + STORED_FORECASTS(idx)(2025:1)
   COMPUTE V = V + STORED_VARIANCES(idx)(2025:1)
END DOFOR
COMPUTE SE=SQRT(V), LO=F-1.96*SE, HI=F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "FEMMES - En Attente" H F LO HI (F-H) (LO-H) (HI-H)

* -- 2. FEMMES SENTENCED --
COMPUTE H=0.0, F=0.0, V=0.0
DOFOR i = 1 TO 8
   COMPUTE idx = (i-1)*4 + 2
   COMPUTE H = H + BOTTOM_LIST(idx)(2024:4)
   COMPUTE F = F + STORED_FORECASTS(idx)(2025:1)
   COMPUTE V = V + STORED_VARIANCES(idx)(2025:1)
END DOFOR
COMPUTE SE=SQRT(V), LO=F-1.96*SE, HI=F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "FEMMES - Condamnees" H F LO HI (F-H) (LO-H) (HI-H)

* -- 3. HOMMES REMANDED --
COMPUTE H=0.0, F=0.0, V=0.0
DOFOR i = 1 TO 8
   COMPUTE idx = (i-1)*4 + 3
   COMPUTE H = H + BOTTOM_LIST(idx)(2024:4)
   COMPUTE F = F + STORED_FORECASTS(idx)(2025:1)
   COMPUTE V = V + STORED_VARIANCES(idx)(2025:1)
END DOFOR
COMPUTE SE=SQRT(V), LO=F-1.96*SE, HI=F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "HOMMES - En Attente" H F LO HI (F-H) (LO-H) (HI-H)

* -- 4. HOMMES SENTENCED --
COMPUTE H=0.0, F=0.0, V=0.0
DOFOR i = 1 TO 8
   COMPUTE idx = (i-1)*4 + 4
   COMPUTE H = H + BOTTOM_LIST(idx)(2024:4)
   COMPUTE F = F + STORED_FORECASTS(idx)(2025:1)
   COMPUTE V = V + STORED_VARIANCES(idx)(2025:1)
END DOFOR
COMPUTE SE=SQRT(V), LO=F-1.96*SE, HI=F+1.96*SE
REPORT(ROW=NEW, ATCOL=1) "HOMMES - Condamnes" H F LO HI (F-H) (LO-H) (HI-H)

REPORT(ACTION=SHOW, TITLE="CROISEMENT GLOBAL GENRE x STATUT")






* -----------------------------------------------------------------
* ETAPE 7 : DETAILS (GENRE x STATUT x ETAT)
* -----------------------------------------------------------------
* On s'assure que les noms d'états sont définis
DEC VECT[STRING] STATE_NAMES(8)
COMPUTE STATE_NAMES = ||"ACT","NSW","NT","QLD","SA","TAS","VIC","WA"||


* =================================================================
* BLOC A : PRISONNIERS EN ATTENTE (REMANDED)
* =================================================================

* --- TABLEAU A1 : FEMMES EN ATTENTE (REMANDED) ---
REPORT(ACTION=DEFINE, HLABELS=||"ETAT", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

DOFOR i = 1 TO 8
   * L'indice pour "femme remanded" est le 1er du bloc de 4
   COMPUTE idx = (i-1)*4 + 1

   * Récupération des données
   COMPUTE V_HIST = BOTTOM_LIST(idx)(2024:4)
   COMPUTE V_FCST = STORED_FORECASTS(idx)(2025:1)
   COMPUTE V_VAR  = STORED_VARIANCES(idx)(2025:1)

   * Calculs statistiques
   COMPUTE SE = SQRT(V_VAR)
   COMPUTE V_LOW = V_FCST - 1.96 * SE
   COMPUTE V_HIGH = V_FCST + 1.96 * SE

   * Calculs des variations
   COMPUTE D_PREV = V_FCST - V_HIST
   COMPUTE D_MIN  = V_LOW - V_HIST
   COMPUTE D_MAX  = V_HIGH - V_HIST

   REPORT(ROW=NEW, ATCOL=1) STATE_NAMES(i) V_HIST V_FCST V_LOW V_HIGH D_PREV D_MIN D_MAX
END DOFOR
REPORT(ACTION=SHOW, TITLE="DETAIL : FEMMES EN ATTENTE (REMANDED)")


* --- TABLEAU A2 : HOMMES EN ATTENTE (REMANDED) ---
REPORT(ACTION=DEFINE, HLABELS=||"ETAT", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

DOFOR i = 1 TO 8
   * L'indice pour "homme remanded" est le 3ème du bloc de 4
   COMPUTE idx = (i-1)*4 + 3

   * Récupération
   COMPUTE V_HIST = BOTTOM_LIST(idx)(2024:4)
   COMPUTE V_FCST = STORED_FORECASTS(idx)(2025:1)
   COMPUTE V_VAR  = STORED_VARIANCES(idx)(2025:1)

   * Statistiques
   COMPUTE SE = SQRT(V_VAR)
   COMPUTE V_LOW = V_FCST - 1.96 * SE
   COMPUTE V_HIGH = V_FCST + 1.96 * SE

   * Variations
   COMPUTE D_PREV = V_FCST - V_HIST
   COMPUTE D_MIN  = V_LOW - V_HIST
   COMPUTE D_MAX  = V_HIGH - V_HIST

   REPORT(ROW=NEW, ATCOL=1) STATE_NAMES(i) V_HIST V_FCST V_LOW V_HIGH D_PREV D_MIN D_MAX
END DOFOR
REPORT(ACTION=SHOW, TITLE="DETAIL : HOMMES EN ATTENTE (REMANDED)")


* =================================================================
* BLOC B : PRISONNIERS CONDAMNES (SENTENCED)
* =================================================================

* --- TABLEAU B1 : FEMMES CONDAMNEES (SENTENCED) ---
REPORT(ACTION=DEFINE, HLABELS=||"ETAT", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

DOFOR i = 1 TO 8
   * L'indice pour "femme sentenced" est le 2ème du bloc de 4
   COMPUTE idx = (i-1)*4 + 2

   * Récupération
   COMPUTE V_HIST = BOTTOM_LIST(idx)(2024:4)
   COMPUTE V_FCST = STORED_FORECASTS(idx)(2025:1)
   COMPUTE V_VAR  = STORED_VARIANCES(idx)(2025:1)

   * Statistiques
   COMPUTE SE = SQRT(V_VAR)
   COMPUTE V_LOW = V_FCST - 1.96 * SE
   COMPUTE V_HIGH = V_FCST + 1.96 * SE

   * Variations
   COMPUTE D_PREV = V_FCST - V_HIST
   COMPUTE D_MIN  = V_LOW - V_HIST
   COMPUTE D_MAX  = V_HIGH - V_HIST

   REPORT(ROW=NEW, ATCOL=1) STATE_NAMES(i) V_HIST V_FCST V_LOW V_HIGH D_PREV D_MIN D_MAX
END DOFOR
REPORT(ACTION=SHOW, TITLE="DETAIL : FEMMES CONDAMNEES (SENTENCED)")


* --- TABLEAU B2 : HOMMES CONDAMNES (SENTENCED) ---
REPORT(ACTION=DEFINE, HLABELS=||"ETAT", "REEL 24:4", "PREV 25:1", "BORNE INF", "BORNE SUP", "VAR PREV.", "VAR MIN", "VAR MAX"||)

DOFOR i = 1 TO 8
   * L'indice pour "homme sentenced" est le 4ème du bloc de 4
   COMPUTE idx = (i-1)*4 + 4

   * Récupération
   COMPUTE V_HIST = BOTTOM_LIST(idx)(2024:4)
   COMPUTE V_FCST = STORED_FORECASTS(idx)(2025:1)
   COMPUTE V_VAR  = STORED_VARIANCES(idx)(2025:1)

   * Statistiques
   COMPUTE SE = SQRT(V_VAR)
   COMPUTE V_LOW = V_FCST - 1.96 * SE
   COMPUTE V_HIGH = V_FCST + 1.96 * SE

   * Variations
   COMPUTE D_PREV = V_FCST - V_HIST
   COMPUTE D_MIN  = V_LOW - V_HIST
   COMPUTE D_MAX  = V_HIGH - V_HIST

   REPORT(ROW=NEW, ATCOL=1) STATE_NAMES(i) V_HIST V_FCST V_LOW V_HIGH D_PREV D_MIN D_MAX
END DOFOR
REPORT(ACTION=SHOW, TITLE="DETAIL : HOMMES CONDAMNES (SENTENCED)")





* -----------------------------------------------------------------
* DIAGNOSTIC DES RESIDUS (TEST)
* -----------------------------------------------------------------

* On modélise le Total directement pour analyser ses résidus
ESMOOTH(TREND=SELECT, SEASONAL=NONE, RESIDS=RESID_TOTAL) TOTAL_AUS

* Test d'autocorrélation (Ljung-Box / Corrélogramme)
CORRELATE(NUMBER=12, QSTATS, SPAN=4, DFC=2) RESID_TOTAL





* -----------------------------------------------------------------
* ETAPE 8 : GRAPHIQUES DE SYNTHESE
* -----------------------------------------------------------------

* 1. CREATION DE LA VARIABLE DE GRISE
SET SHADE_ZONE = 0.0
COMPUTE SHADE_ZONE(2025:1) = 1.0

* -----------------------------------------------------------------
* PREPARATION DES DONNEES
* -----------------------------------------------------------------

* A. PREPARATION STATUTS (Remanded vs Sentenced)
SET PLOT_REM = TOTAL_REMANDED
SET PLOT_SEN = TOTAL_SENTENCED
COMPUTE PLOT_REM(2025:1) = FCST_REMANDED(2025:1)
COMPUTE PLOT_SEN(2025:1) = FCST_SENTENCED(2025:1)


* B. PREPARATION ETATS

DEC VECT[SERIES] PLOT_STATES(8)
DOFOR i = 1 TO 8
   COMPUTE base_idx = (i-1)*4
   SET PLOT_STATES(i) = BOTTOM_LIST(base_idx+1) + BOTTOM_LIST(base_idx+2) + BOTTOM_LIST(base_idx+3) + BOTTOM_LIST(base_idx+4)

   COMPUTE val_fcst = STORED_FORECASTS(base_idx+1)(2025:1) + STORED_FORECASTS(base_idx+2)(2025:1) + $
                      STORED_FORECASTS(base_idx+3)(2025:1) + STORED_FORECASTS(base_idx+4)(2025:1)
   COMPUTE PLOT_STATES(i)(2025:1) = val_fcst
END DOFOR


* C. PREPARATION FOCUS VICTORIA
SET VIC_REM_HIST = VICFRemanded + VICMRemanded
SET VIC_SEN_HIST = VICFSentenced + VICMSentenced
SET PLOT_VIC_REM = VIC_REM_HIST
SET PLOT_VIC_SEN = VIC_SEN_HIST
COMPUTE PLOT_VIC_REM(2025:1) = STORED_FORECASTS(25)(2025:1) + STORED_FORECASTS(27)(2025:1)
COMPUTE PLOT_VIC_SEN(2025:1) = STORED_FORECASTS(26)(2025:1) + STORED_FORECASTS(28)(2025:1)



* D. PREPARATION GENRE FEMME
SET PLOT_FEMMES = TOTAL_F
COMPUTE PLOT_FEMMES(2025:1) = FCST_FEMME(2025:1)



* -----------------------------------------------------------------
* ETAPE 8 : GRAPHIQUES DE SYNTHESE (FINAUX)
* -----------------------------------------------------------------

* 1. CREATION DE LA VARIABLE DE GRISE
SET SHADE_ZONE = 0.0
COMPUTE SHADE_ZONE(2025:1) = 1.0

* =================================================================
* PREPARATION DES DONNEES
* =================================================================

* --- A. TOTAL AUSTRALIE ---
SET PLOT_TOTAL = TOTAL_AUS
COMPUTE PLOT_TOTAL(2025:1) = FCST_TOTAL(2025:1)


* ================================================================
* INTERVALLE DE CONFIANCE 95% - TOTAL AUSTRALIE (SEGMENT VERTICAL)
* ================================================================
SET IC_LOW_TOTAL  = %NA
SET IC_HIGH_TOTAL = %NA

* On duplique la valeur sur 2024:4 et 2025:1
COMPUTE IC_LOW_TOTAL(2024:4)  = FCST_TOTAL(2025:1) - 1.96 * SE_TOTAL(2025:1)
COMPUTE IC_LOW_TOTAL(2025:1)  = IC_LOW_TOTAL(2024:4)

COMPUTE IC_HIGH_TOTAL(2024:4) = FCST_TOTAL(2025:1) + 1.96 * SE_TOTAL(2025:1)
COMPUTE IC_HIGH_TOTAL(2025:1) = IC_HIGH_TOTAL(2024:4)



* --- B. PREPARATION STATUTS ---
SET PLOT_REM = TOTAL_REMANDED
SET PLOT_SEN = TOTAL_SENTENCED
COMPUTE PLOT_REM(2025:1) = FCST_REMANDED(2025:1)
COMPUTE PLOT_SEN(2025:1) = FCST_SENTENCED(2025:1)



* ================================================================
* INTERVALLES DE CONFIANCE 95% - STATUT JURIDIQUE
* ================================================================

* --- REMANDED ---
SET IC_LOW_REM  = %NA
SET IC_HIGH_REM = %NA

COMPUTE IC_LOW_REM(2024:4)  = FCST_REMANDED(2025:1) - 1.96 * SE_REMANDED(2025:1)
COMPUTE IC_LOW_REM(2025:1)  = IC_LOW_REM(2024:4)

COMPUTE IC_HIGH_REM(2024:4) = FCST_REMANDED(2025:1) + 1.96 * SE_REMANDED(2025:1)
COMPUTE IC_HIGH_REM(2025:1) = IC_HIGH_REM(2024:4)


* --- SENTENCED ---
SET IC_LOW_SEN  = %NA
SET IC_HIGH_SEN = %NA

COMPUTE IC_LOW_SEN(2024:4)  = FCST_SENTENCED(2025:1) - 1.96 * SE_SENTENCED(2025:1)
COMPUTE IC_LOW_SEN(2025:1)  = IC_LOW_SEN(2024:4)

COMPUTE IC_HIGH_SEN(2024:4) = FCST_SENTENCED(2025:1) + 1.96 * SE_SENTENCED(2025:1)
COMPUTE IC_HIGH_SEN(2025:1) = IC_HIGH_SEN(2024:4)




* --- C. PREPARATION ETATS ---
DEC VECT[SERIES] PLOT_STATES(8)
DOFOR i = 1 TO 8
   COMPUTE base_idx = (i-1)*4
   SET PLOT_STATES(i) = BOTTOM_LIST(base_idx+1) + BOTTOM_LIST(base_idx+2) + BOTTOM_LIST(base_idx+3) + BOTTOM_LIST(base_idx+4)

   COMPUTE val_fcst = STORED_FORECASTS(base_idx+1)(2025:1) + STORED_FORECASTS(base_idx+2)(2025:1) + $
                      STORED_FORECASTS(base_idx+3)(2025:1) + STORED_FORECASTS(base_idx+4)(2025:1)
   COMPUTE PLOT_STATES(i)(2025:1) = val_fcst
END DOFOR





* --- D. PREPARATION FOCUS VICTORIA ---
SET VIC_REM_HIST = VICFRemanded + VICMRemanded
SET VIC_SEN_HIST = VICFSentenced + VICMSentenced
SET PLOT_VIC_REM = VIC_REM_HIST
SET PLOT_VIC_SEN = VIC_SEN_HIST
COMPUTE PLOT_VIC_REM(2025:1) = STORED_FORECASTS(25)(2025:1) + STORED_FORECASTS(27)(2025:1)
COMPUTE PLOT_VIC_SEN(2025:1) = STORED_FORECASTS(26)(2025:1) + STORED_FORECASTS(28)(2025:1)

* --- E. PREPARATION GENRE FEMME ---
SET PLOT_FEMMES = TOTAL_F
COMPUTE PLOT_FEMMES(2025:1) = FCST_FEMME(2025:1)


* ================================================================
* INTERVALLES DE CONFIANCE 95% - FOCUS VICTORIA & FEMMES
* ================================================================

* --- VICTORIA : REMANDED ---
SET IC_LOW_VIC_REM  = %NA
SET IC_HIGH_VIC_REM = %NA

COMPUTE IC_LOW_VIC_REM(2024:4)  = PLOT_VIC_REM(2025:1) - 1.96 * SE_REMANDED(2025:1)
COMPUTE IC_LOW_VIC_REM(2025:1)  = IC_LOW_VIC_REM(2024:4)

COMPUTE IC_HIGH_VIC_REM(2024:4) = PLOT_VIC_REM(2025:1) + 1.96 * SE_REMANDED(2025:1)
COMPUTE IC_HIGH_VIC_REM(2025:1) = IC_HIGH_VIC_REM(2024:4)


* --- VICTORIA : SENTENCED ---
SET IC_LOW_VIC_SEN  = %NA
SET IC_HIGH_VIC_SEN = %NA

COMPUTE IC_LOW_VIC_SEN(2024:4)  = PLOT_VIC_SEN(2025:1) - 1.96 * SE_SENTENCED(2025:1)
COMPUTE IC_LOW_VIC_SEN(2025:1)  = IC_LOW_VIC_SEN(2024:4)

COMPUTE IC_HIGH_VIC_SEN(2024:4) = PLOT_VIC_SEN(2025:1) + 1.96 * SE_SENTENCED(2025:1)
COMPUTE IC_HIGH_VIC_SEN(2025:1) = IC_HIGH_VIC_SEN(2024:4)


* --- FEMMES (TOTAL) ---
SET IC_LOW_FEMMES  = %NA
SET IC_HIGH_FEMMES = %NA

COMPUTE IC_LOW_FEMMES(2024:4)  = FCST_FEMME(2025:1) - 1.96 * SE_FEMME(2025:1)
COMPUTE IC_LOW_FEMMES(2025:1)  = IC_LOW_FEMMES(2024:4)

COMPUTE IC_HIGH_FEMMES(2024:4) = FCST_FEMME(2025:1) + 1.96 * SE_FEMME(2025:1)
COMPUTE IC_HIGH_FEMMES(2025:1) = IC_HIGH_FEMMES(2024:4)




